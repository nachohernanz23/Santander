# API de votos de la web del viaje (server/server.js).
# node --watch reinicia solo cuando el git pull del cron trae cambios.
[Unit]
Description=API de votos del viaje por Cantabria
After=network.target

[Service]
User=ubuntu
Environment=PORT=8797
Environment=DATA_DIR=/var/lib/santander
StateDirectory=santander
WorkingDirectory=/var/www/santander
ExecStart=/usr/bin/node --watch /var/www/santander/server/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
